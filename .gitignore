# R / Bioconductor project .gitignore for TSSwitch

# ── Raw & large data files ─────────────────────────────────────────────────────
# These files must NEVER be committed directly.
# Use Git LFS (git lfs track) or keep them on a data server and document paths.

# FASTQ reads (raw and trimmed)
*.fastq
*.fastq.gz
*.fq
*.fq.gz

# Alignment files
*.bam
*.bam.bai
*.sam
*.cram

# Genome/annotation files
*.gtf
*.gff
*.gff3
*.fa
*.fasta
*.fa.gz
*.fasta.gz

# Salmon quantification output directories
*_quant/

# Bambu output
*.RData

# Large count matrices and TPM tables
# (Track only small example files; keep full data on server)
*_counts_transcript*.txt
*_tpm*.txt
bambu_tx_tpm*.txt
transcript_tpm.txt
transcript_counts.txt

# SUPPA2 PSI files
*.psi
*.ioe
*.ioi

# CPAT / CPC2 output
cpat_result.txt
*.cpc2output

# ── R-specific ─────────────────────────────────────────────────────────────────
# R session state and history
.RData
.Rhistory
.RDataTmp
.Rapp.history

# RDS checkpoints (intermediate pipeline objects — large, reproducible from scripts)
*.rds
*.RDS

# R package library (if using renv or packrat)
renv/library/
renv/.cache/
packrat/lib/
packrat/lib-ext/
packrat/lib-R/

# Compiled R/C code
*.so
*.dylib
*.dll
src/*.o
src/*.so

# ── Output files (figures and tables) ─────────────────────────────────────────
# These are generated by the pipeline and should not be version-controlled.
# Commit only final publication figures if needed.
figures/
tables/
*.png
*.pdf
*.svg
*.eps
*.tiff

# Exception: allow small example/demo figures in the repo root if added explicitly
# !example_output/

# ── OS / editor files ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes
desktop.ini

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# ── Retired / hidden analyses ──────────────────────────────────────────────────
# PRJNA1206164 (whole-genome-wide short-read DTU/beta-regression pipeline) has
# been superseded by the ERP161086 independent short-read concordance analysis
# and the targeted 86-gene splicing analysis in syn52047893/. The folder is kept
# locally for reference but is intentionally excluded from version control.
PRJNA1206164/

# JetBrains / RStudio
.Rproj.user/
*.Rproj
*.Rproj.user
*.swp
*~

# ── Credentials and sensitive paths ───────────────────────────────────────────
# Never commit files containing server paths, passwords, tokens, or keys
config_local.R
.env
secrets.R
credentials.R

# ── Temporary / log files ─────────────────────────────────────────────────────
*.log
*.tmp
*.temp
logs/
tmp/
temp/

# ── Trimmomatic adapter files ─────────────────────────────────────────────────
TruSeq*.fa
NexteraPE*.fa

# ── SRA accession lists (may contain study-specific info) ─────────────────────
# Comment this out if you want to track accession lists in the repo
# SRR_Acc_List.txt
